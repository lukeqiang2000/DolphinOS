# DolphinOS 包列表（chroot 阶段安装）
# Live 基础
live-boot
live-config
systemd-sysv

# 开机动画（Alpha 10 起：dolphin 主题改用 two-step 插件实现，
# two-step.so 由 plymouth-themes 包提供，必须一并装入；
# 原 script 插件在 plymouth 26.134.222 里对一切 script 主题必崩，
# 见 ALPHA10-REPORT.md 的二分取证。主题文件与默认主题切换见
# includes.chroot 与 0100-plymouth-theme.hook.chroot）
plymouth
plymouth-themes

# Wayland 会话与登录链（Alpha 7：greetd + 自研 dolphin-greeter；
# Alpha 8：greeter 改由 cage 托管，见 greetd config.toml 的说明；
# agreety 是 greetd 包自带、无独立包，保留无妨但不再是默认会话）
# cage：最小 kiosk 合成器，只负责给登录屏提供 Wayland 显示环境
labwc
seatd
greetd
cage
# xwayland：cage 启动时会创建 XWayland 服务，镜像里缺 /usr/bin/Xwayland 时
# cage 报 "Cannot create XWayland server"（Alpha 8 登出后日志实证）；且 X11
# 客户端（旧版 Linux 应用）也需要它。
xwayland

# 桌面兜底与终端兜底
# swaybg：登录后蓝底兜底（Shell 没起来时证明合成器活着）
# foot：Super+Shift+Enter 兜底终端（主终端已换自研 dolphin-terminal）
# thunar 已移除：文件管理由自研 dolphin-files 接替
# wlr-randr：Alpha 10 起 autostart 用它做输出收敛（只启用第一块
# connected 输出，其余关闭），配合 rc.xml 的 autoEnableOutputs=no，
# 防止 Shell 全屏窗口被 labwc 放到不可见的幻影输出上
swaybg
foot
wlr-randr

# 自研应用运行时库（dolphin-* 二进制由 CI 注入 /usr/bin）
# Slint 运行时、浏览器 WebKit 内核运行时、播放器 GStreamer 运行时
libfontconfig1
libxkbcommon0
libwebkit2gtk-4.1-0
libgstreamer1.0-0
libgstreamer-plugins-base1.0-0
gstreamer1.0-plugins-base
gstreamer1.0-plugins-good

# 网络与多媒体栈
network-manager
pipewire
wireplumber
xdg-desktop-portal-wlr

# 应用商店（Alpha 10 用户改定）：Bazaar（Kolunmi 的 Flatpak 商店，
# sid 有现成包，依赖自动带入 flatpak）；Flathub 系统源由
# 0110-bazaar-flathub.hook.chroot 预置。原定 GNOME Software 从未
# 真正进过包列表（Shell 卡片指向的是不存在的程序），本次一并改正。
bazaar

# 安装完整版引擎（dolphin-install）的工具链：把 Live 系统装到硬盘时
# 需要在目标系统里装引导并生成 grub.cfg。注意 grub-pc 与
# grub-efi-amd64 两个平台包互相 Conflicts 不能同装，而 Live 镜像两种
# 固件都要支持——实查（sid 2.14-5）grub-install/update-grub 本体在
# grub2-common 里，i386-pc 与 x86_64-efi 的模块分别在 grub-pc-bin、
# grub-efi-amd64-bin(+unsigned) 里，两个 -bin 包互不冲突。故装
# common+双 bin 组合，grub-install --target 按固件选模块即可。
# dosfstools 提供 ESP 的 mkfs.vfat；分区用 fdisk 包的 sfdisk、
# 复制用 rsync（底座已带，显式写死防丢）。
grub-common
grub2-common
grub-pc-bin
grub-efi-amd64-bin
grub-efi-amd64-unsigned
efibootmgr
dosfstools
fdisk
rsync

# 硬件适配（Alpha 10 用户口径：固件与微码开箱拉满）：通用固件元包、
# 非自由固件元包（走 non-free-firmware 分区，构建时已启用）、
# AMD/Intel CPU 微码（开机由内核 initramfs 早期加载）。
firmware-linux
firmware-linux-nonfree
amd64-microcode
intel-microcode

# 图标/光标主题（显式声明：Alpha 7 时它靠传递依赖带入，
# 哪天上游依赖关系变了可能悄悄消失，故在此写死）
adwaita-icon-theme

# 字体（中文显示）
fonts-noto-cjk
