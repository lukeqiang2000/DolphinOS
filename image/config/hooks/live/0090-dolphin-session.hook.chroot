#!/bin/sh
# DolphinOS 会话收尾 hook（chroot 阶段执行）：
# 1. 确保 greetd 默认会话指向自研图形登录屏 dolphin-greeter（与 includes.chroot 的 config.toml 双保险）。
#    登录成功后由 greeter 请求启动 /usr/local/bin/dolphin-session 包装脚本拉起 labwc。
# 2. 启用 greetd 与 seatd 服务，保证开机进登录链、非 root 会话能拿到 seat。
set -e

if [ -f /etc/greetd/config.toml ]; then
    # 注意：这里的命令串必须与 includes.chroot 的 config.toml 里
    # default_session 的 command 逐字一致。Alpha 8 首建时这里还留着
    # Alpha 7 的裸 greeter 串，grep 不中便往文件末尾追加了一整节旧版
    # [default_session]，造成重复表、TOML 解析失败（镜像实读才发现）。
    # 以后改 default_session 命令，两处必须同步改。
    grep -qF 'command = "/usr/local/bin/dolphin-greeter-session"' /etc/greetd/config.toml || \
        printf '\n[default_session]\ncommand = "/usr/local/bin/dolphin-greeter-session"\nuser = "_greetd"\n' >> /etc/greetd/config.toml
fi

# 会话包装脚本必须在位且可执行：它负责 labwc 默认渲染失败时改用 pixman 软件渲染重试
if [ -f /usr/local/bin/dolphin-session ]; then
    chmod +x /usr/local/bin/dolphin-session || true
else
    echo "警告: /usr/local/bin/dolphin-session 不存在，greetd 会话将无法启动" >&2
fi

# 登录屏会话包装与 Shell 启动器同样必须在位且可执行（Alpha 9 新增）；
# dolphin-output-setup 是 Alpha 10 的 autostart 输出收敛脚本；
# dolphin-calamares* 是 Alpha 11 的 Calamares 安装入口三件
# （启动器/root 包装/装盘收尾），一并校验
for script in dolphin-greeter-session dolphin-shell-launcher dolphin-output-setup dolphin-calamares dolphin-calamares-root dolphin-calamares-finalize; do
    if [ -f "/usr/local/bin/$script" ]; then
        chmod +x "/usr/local/bin/$script" || true
    else
        echo "警告: /usr/local/bin/$script 不存在" >&2
    fi
done

# 自研二进制由 CI 在构建 ISO 前注入 includes.chroot/usr/bin，缺失时明确警告
for bin in dolphin-greeter dolphin-shell dolphin-settings dolphin-files dolphin-terminal dolphin-browser dolphin-player dolphin-photos dolphin-oobe; do
    if [ -f "/usr/bin/$bin" ]; then
        chmod +x "/usr/bin/$bin" || true
    else
        echo "警告: /usr/bin/$bin 不存在（CI 未注入自研二进制？）" >&2
    fi
done

systemctl enable greetd.service 2>/dev/null || true
systemctl enable seatd.service 2>/dev/null || true
# 屏蔽 tty1 的 getty：防止 live-config 的 getty 自动登录抢占 vt1，让 greetd 接管图形登录
# （与 build.sh 的 live-config.noautologin 启动参数双保险）
systemctl mask getty@tty1.service 2>/dev/null || true
# seatd 组成员：默认 live 用户需要 seat 权限时由 live-config 处理，这里仅保证组存在
getent group seatd >/dev/null || groupadd -r seatd || true
