#!/bin/sh
# DolphinOS 品牌化：改写 live-build 生成的 GRUB 条目标签。
#
# 「Live system (...)」这类标签是 live-build 的 binary_grub_cfg 脚本在
# 代码里写死拼接后注入 grub.cfg 的，config/bootloaders 的模板覆盖改
# 不到它。binary_hooks 在 binary 阶段末尾运行（grub_cfg、splash 都已
# 生成，ISO 尚未打包），是唯一能改到最终 grub.cfg 的口子。
# 本 hook 运行时工作目录为 binary/（live-build 约定），故路径相对它写。
set -e

GRUB_CFG="boot/grub/grub.cfg"

if [ -f "${GRUB_CFG}" ]; then
    # Alpha 10：开机不显示菜单、直接进默认条目（模板 grub.cfg 里已有同款两行，
    # 这里是双保险：若 live-build 换了模板处理方式，最终文件仍被强制改掉）。
    # timeout_style=hidden + timeout=0：不留可被按键打断的倒计时窗口
    # （Alpha 9 的 timeout=1 在 VirtualBox 里被窗口内的按键事件取消倒计时、
    # 停在菜单等选择，见 grub.cfg 模板注释）；按住 Shift/Esc 仍可调出菜单。
    if ! grep -q 'timeout_style=hidden' "${GRUB_CFG}"; then
        sed -i '/^source \/boot\/grub\/config.cfg$/a set timeout_style=hidden\nset timeout=0' "${GRUB_CFG}"
    fi
    sed -i \
        -e 's| fail-safe mode)| Safe Mode)|g' \
        -e 's|Live system (|DolphinOS Alpha (|g' \
        -e 's|Live system, kernel |DolphinOS Alpha, kernel |g' \
        "${GRUB_CFG}"
fi
