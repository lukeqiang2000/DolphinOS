#!/bin/sh
# DolphinOS 开机动画收尾 hook（chroot 阶段执行，排在 0090 之后）：
#
# 背景：plymouth 的 initramfs hook 收录哪套主题，看的是
# default.plymouth 的 update-alternatives 指向，而不是 plymouthd.conf
# （plymouth 24.x 包的 /usr/share/initramfs-tools/hooks/plymouth 实证：
# 它用 update-alternatives --query default.plymouth 取主题路径，再把
# 整个主题目录拷进 initramfs）。所以这里必须：
#   1. 把 default.plymouth 的 alternatives 指到 dolphin 主题；
#      优先用 plymouth-set-default-theme（若该版本 plymouth 还带），
#      否则直接用 update-alternatives 注册+选定（等价操作，不依赖
#      那个在新版包里已不附带的脚本）；
#   2. plymouthd.conf 与之对齐（includes.chroot 已带 Theme=dolphin，
#      这里兜底校验）；
#   3. update-initramfs -u —— 在主题文件已随 includes 落地后重建
#      initramfs，把 dolphin 主题（script 插件 + 12 帧图）打进去。
# chroot 阶段顺序上 initramfs 在内核安装时已生成过一版，hooks 在其后
# 运行，本 hook 的重建是最终版，binary 阶段拷走的就是这一版。
set -e

THEME_FILE=/usr/share/plymouth/themes/dolphin/dolphin.plymouth

if [ ! -f "${THEME_FILE}" ]; then
    echo "警告: dolphin plymouth 主题不在位，跳过开机动画设置" >&2
    exit 0
fi

if command -v plymouth-set-default-theme >/dev/null 2>&1; then
    plymouth-set-default-theme dolphin || \
        echo "警告: plymouth-set-default-theme 执行失败" >&2
elif command -v update-alternatives >/dev/null 2>&1; then
    update-alternatives --install /usr/share/plymouth/themes/default.plymouth \
        default.plymouth "${THEME_FILE}" 100 >/dev/null 2>&1 || true
    update-alternatives --set default.plymouth "${THEME_FILE}" || \
        echo "警告: update-alternatives 选定 dolphin 主题失败" >&2
else
    echo "警告: 没有可用的主题切换工具，开机动画可能不生效" >&2
fi

# 校验 alternatives 实际指向（结果进构建日志，方便 Alpha 8 排查）
if command -v update-alternatives >/dev/null 2>&1; then
    echo "default.plymouth 当前指向："
    update-alternatives --query default.plymouth 2>/dev/null | grep '^Value:' || \
        echo "（未查到 default.plymouth alternatives）"
fi

# 兜底对齐 plymouthd.conf
if [ -f /etc/plymouth/plymouthd.conf ]; then
    grep -q '^Theme=dolphin' /etc/plymouth/plymouthd.conf || \
        printf '[Daemon]\nTheme=dolphin\nShowDelay=0\n' >> /etc/plymouth/plymouthd.conf
fi

update-initramfs -u || echo "警告: update-initramfs 重建失败，开机动画可能不生效" >&2
