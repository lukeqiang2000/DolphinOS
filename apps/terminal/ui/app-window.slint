// DolphinOS 终端界面：整窗一块等宽文本区，FocusScope 捕获全部按键，
// 编码后由 Rust 写入 pty；屏幕内容由 Rust 侧网格状态机渲染成纯文本。

export component AppWindow inherits Window {
    in-out property <string> screen: "";
    // 按键转发给 Rust：text 是按键文本，ctrl 表示 Ctrl 是否按下。
    callback keys-typed(string, bool);

    title: "Dolphin 终端";
    preferred-width: 900px;
    preferred-height: 620px;
    background: #0c0f12;

    init => {
        fs.focus();
    }

    fs := FocusScope {
        width: 100%;
        height: 100%;

        key-pressed(event) => {
            root.keys-typed(event.text, event.modifiers.control);
            accept
        }

        Rectangle {
            background: #0c0f12;

            Text {
                x: 10px;
                y: 8px;
                width: parent.width - 20px;
                height: parent.height - 16px;
                text: root.screen;
                color: #d7e0ea;
                font-family: "monospace";
                font-size: 14px;
                wrap: no-wrap;
                vertical-alignment: top;
                horizontal-alignment: left;
            }
        }
    }
}
