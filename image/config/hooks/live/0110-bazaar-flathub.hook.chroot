#!/bin/sh
# DolphinOS 应用商店收尾 hook（chroot 阶段执行，排在 0100 之后）：
# 给系统级 flatpak 预置 Flathub 源，Bazaar（包列表里的 bazaar）开机
# 就能浏览/安装 Flathub 上的应用，不用用户再手动加源。
# remote-add 读 includes.chroot 预置的 flathub.flatpakrepo 文件完成，
# 只写 /var/lib/flatpak 的源配置，不需要网络与守护进程；
# flatpak 本体由 bazaar 的包依赖带入，缺了就明确警告、不中断构建。
set -e

REPO_FILE=/usr/share/dolphinos/flathub.flatpakrepo

if ! command -v flatpak >/dev/null 2>&1; then
    echo "警告: flatpak 不在位（bazaar 未装？），跳过 Flathub 源预置" >&2
    exit 0
fi

if [ ! -f "$REPO_FILE" ]; then
    echo "警告: $REPO_FILE 缺失，跳过 Flathub 源预置" >&2
    exit 0
fi

flatpak remote-add --system --if-not-exists flathub "$REPO_FILE" || \
    echo "警告: 预置 Flathub 系统源失败，Bazaar 首次启动时需手动添加" >&2

# 预取 Flathub 的 appstream 目录数据进系统仓库（Alpha 10 修复：
# 「Bazaar 加载缓慢」）：remote-add 只写源配置、不拉任何数据，
# Bazaar 首启必须先把整份目录（appstream XML + 图标，数十 MB）
# 下载并部署完才能列出应用，在虚拟机/慢网络上要等很久。构建期
# 先拉好放进 /var/lib/flatpak/appstream，开机打开商店即可直接
# 浏览。构建环境无网络或 flatpak 需要系统总线而失败时只警告
# 不中断：最坏情况退回首启现拉（慢但可用），不让整轮构建陪葬。
flatpak --system update --appstream flathub || \
    echo "警告: 预取 Flathub appstream 目录失败，Bazaar 首次启动仍需现拉目录" >&2

echo "0110: Flathub 系统源预置完成"
