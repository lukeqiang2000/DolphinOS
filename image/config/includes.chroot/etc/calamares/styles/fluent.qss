/* DolphinOS 安装程序样式 — Fluent（仿 Windows 10）
 * Acrylic 观感的 QSS 近似：浅色半透面板（rgba 白）+ 细边框 + 小圆角，
 * 强调色用 Win10 蓝 #0067c0（系统 Fluent palette 的 #4cc2ff 是深色底
 * 强调色，浅色底上改用同系深蓝）。QSS 做不了真实背景模糊，用分层
 * 半透色块模拟亚克力层次。 */

QWidget {
    background-color: #f3f3f3;
    color: #1b1b1b;
    font-size: 14px;
}

QListWidget {
    background-color: rgba(255, 255, 255, 160);
    border: none;
    outline: none;
    padding: 12px 8px;
}
QListWidget::item {
    padding: 10px 12px;
    border-radius: 4px;
    color: #4d4d4d;
}
QListWidget::item:selected { background-color: #0067c0; color: #ffffff; }
QListWidget::item:hover:!selected { background-color: rgba(0, 103, 192, 30); color: #1b1b1b; }

QPushButton {
    background-color: rgba(255, 255, 255, 200);
    border: 1px solid #d1d1d1;
    border-radius: 4px;
    padding: 7px 18px;
    color: #1b1b1b;
}
QPushButton:hover { background-color: rgba(255, 255, 255, 255); border-color: #0067c0; }
QPushButton:pressed { background-color: #0067c0; color: #ffffff; }
QPushButton:disabled { color: #a19f9d; border-color: #e1dfdd; }
QPushButton:default { background-color: #0067c0; border-color: #0067c0; color: #ffffff; }

QLineEdit, QComboBox, QSpinBox, QTextEdit, QPlainTextEdit {
    background-color: rgba(255, 255, 255, 220);
    border: 1px solid #d1d1d1;
    border-radius: 4px;
    padding: 6px 10px;
    color: #1b1b1b;
    selection-background-color: #0067c0;
    selection-color: #ffffff;
}
QLineEdit:focus, QComboBox:focus, QSpinBox:focus { border-color: #0067c0; }
QComboBox::drop-down { border: none; width: 22px; }

QProgressBar {
    background-color: rgba(255, 255, 255, 200);
    border: 1px solid #d1d1d1;
    border-radius: 4px;
    text-align: center;
    color: #1b1b1b;
    height: 14px;
}
QProgressBar::chunk { background-color: #0067c0; border-radius: 3px; }

QCheckBox, QRadioButton { spacing: 8px; }
QCheckBox::indicator, QRadioButton::indicator {
    width: 18px; height: 18px;
    border: 1px solid #8a8886;
    background-color: rgba(255, 255, 255, 220);
}
QCheckBox::indicator { border-radius: 4px; }
QRadioButton::indicator { border-radius: 9px; }
QCheckBox::indicator:checked, QRadioButton::indicator:checked {
    background-color: #0067c0;
    border-color: #0067c0;
}

QGroupBox {
    border: 1px solid #d1d1d1;
    border-radius: 4px;
    margin-top: 12px;
    padding-top: 10px;
    background-color: rgba(255, 255, 255, 120);
}
QGroupBox::title { subcontrol-origin: margin; left: 10px; padding: 0 4px; color: #4d4d4d; }

QScrollBar:vertical { background: transparent; width: 10px; border: none; }
QScrollBar::handle:vertical { background: #c8c6c4; border-radius: 5px; min-height: 30px; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar:horizontal { background: transparent; height: 10px; border: none; }
QScrollBar::handle:horizontal { background: #c8c6c4; border-radius: 5px; min-width: 30px; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; }

QToolTip { background-color: #ffffff; color: #1b1b1b; border: 1px solid #d1d1d1; }
