// DolphinOS Shell 正式版界面：28px 窄顶栏（时间+状态）+ 板块网格桌面 + 左上角找应用入口 + 系统板块卡。
// 主题配色/圆角由 Rust 按 dolphin-config 的 palette() 注入属性，切换主题即换整套数据层皮肤。

import { LineEdit, ScrollView } from "std-widgets.slint";

export struct DesktopCard {
    idx: int,
    name: string,
    exec: string,
    section: string,
    frequent: bool,
}

component Card inherits Rectangle {
    in property <int> idx;
    in property <string> name;
    in property <string> section;
    in property <bool> frequent;
    in property <length> radius;
    in property <color> card-bg;
    in property <color> border-col;
    in property <color> text-col;
    in property <color> sub-col;
    in property <color> accent-col;
    in property <float> flip-scale: 1.0;
    callback launch(int);
    callback shift(int, int);

    width: 160px;
    height: 140px;
    background: transparent;

    Rectangle {
        width: 100%;
        height: 100%;
        border-radius: root.radius;
        background: root.card-bg;
        border-width: 1px;
        border-color: root.border-col;
        // 翻转动画的横向缩放必须挂在非根元素上（根元素 transform 不生效，编译器实测）
        transform-scale-x: root.flip-scale;

        VerticalLayout {
        padding: 12px;
        spacing: 6px;

        HorizontalLayout {
            Text {
                text: root.frequent ? "★" : "▦";
                color: root.accent-col;
                font-size: 20px;
            }
            Rectangle {}
            Rectangle {
                width: 22px;
                height: 22px;
                Text { text: "◀"; color: root.sub-col; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
                TouchArea { clicked => { root.shift(root.idx, root.idx - 1); } }
            }
            Rectangle {
                width: 22px;
                height: 22px;
                Text { text: "▶"; color: root.sub-col; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
                TouchArea { clicked => { root.shift(root.idx, root.idx + 1); } }
            }
        }

        Text {
            text: root.name;
            color: root.text-col;
            font-size: 17px;
        }

        Text {
            text: root.section;
            color: root.sub-col;
            font-size: 11px;
        }
    }

        TouchArea {
            y: 44px;
            height: parent.height - 44px;
            clicked => { root.launch(root.idx); }
        }
    }
}

component BarButton inherits Rectangle {
    in property <string> label;
    in property <color> text-col;
    in property <color> panel-bg;
    callback clicked();

    height: 34px;
    border-radius: 8px;
    background: root.panel-bg;

    Text {
        text: root.label;
        color: root.text-col;
        font-size: 13px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    TouchArea { clicked => { root.clicked(); } }
}

export component AppWindow inherits Window {
    in-out property <string> clock: "--:--";
    in property <string> theme-name: "Dolphin";
    in property <color> c-bg: #0b0e11;
    in property <color> c-panel: #10151b;
    in property <color> c-card: #1a2129;
    in property <color> c-border: #2b3644;
    in property <color> c-accent: #1370f3;
    in property <color> c-text: #e8eef4;
    in property <color> c-sub: #8fa3b8;
    in property <length> corner-radius: 18px;
    in property <[DesktopCard]> cards;
    in property <[DesktopCard]> launcher-cards;
    in-out property <bool> launcher-open: false;
    in-out property <string> search-text: "";
    in-out property <bool> show-entry-text: true;
    in property <int> flipping-index: -1;
    in property <float> flip-scale: 1.0;
    in property <string> status-text: "";

    callback launch-app(int);
    callback shift-card(int, int);
    callback search-changed(string);
    callback open-settings();
    callback power-off();
    callback reboot();

    title: "DolphinOS Shell";
    preferred-width: 1280px;
    preferred-height: 800px;
    background: root.c-bg;

    VerticalLayout {
        // ── 28px 窄顶栏：只放时间与状态图标（规格定案）──
        Rectangle {
            height: 28px;
            background: root.c-panel;

            HorizontalLayout {
                padding-left: 8px;
                padding-right: 12px;
                spacing: 10px;

                // 左上角找应用入口：文字先显示、数秒后自动隐藏，悬停再显示
                Rectangle {
                    width: 64px;
                    background: transparent;
                    Text {
                        text: "应用";
                        color: root.c-sub;
                        font-size: 12px;
                        vertical-alignment: center;
                        visible: entry-touch.has-hover || root.show-entry-text;
                    }
                    Text {
                        text: "▦";
                        color: root.c-sub;
                        font-size: 12px;
                        vertical-alignment: center;
                        visible: !entry-touch.has-hover && !root.show-entry-text;
                    }
                    entry-touch := TouchArea {
                        clicked => { root.launcher-open = !root.launcher-open; }
                    }
                }

                Rectangle {}

                Text {
                    text: "◉ ◉";
                    color: root.c-sub;
                    font-size: 11px;
                    vertical-alignment: center;
                }

                Text {
                    text: root.clock;
                    color: root.c-text;
                    font-size: 12px;
                    vertical-alignment: center;
                }
            }
        }

        // ── 找应用面板（滚轮/搜索展开全部应用）──
        if root.launcher-open: Rectangle {
            height: 264px;
            background: root.c-panel;

            VerticalLayout {
                padding: 12px;
                spacing: 8px;

                LineEdit {
                    text <=> root.search-text;
                    placeholder-text: "搜索应用…";
                    edited => { root.search-changed(self.text); }
                }

                ScrollView {
                    VerticalLayout {
                        spacing: 2px;
                        for card in root.launcher-cards: Rectangle {
                            height: 34px;
                            border-radius: 6px;
                            background: transparent;
                            HorizontalLayout {
                                padding-left: 8px;
                                spacing: 8px;
                                Text { text: card.name; color: root.c-text; font-size: 13px; vertical-alignment: center; }
                                Text { text: card.section; color: root.c-sub; font-size: 11px; vertical-alignment: center; }
                            }
                            TouchArea { clicked => { root.launch-app(card.idx); } }
                        }
                    }
                }
            }
        }

        // ── 板块网格桌面 ──
        ScrollView {
            Rectangle {
                height: (root.cards.length + 3) / 4 * 156px + 190px;
                background: transparent;

                Text {
                    x: 24px;
                    y: 10px;
                    text: "桌面 · 常用应用直接成卡，其余按板块排列（卡片 ◀ ▶ 可调顺序，位置会记住）";
                    color: root.c-sub;
                    font-size: 12px;
                }

                for card[i] in root.cards: Card {
                    x: 24px + Math.mod(i, 4) * 176px;
                    y: 40px + Math.floor(i / 4) * 156px;
                    idx: card.idx;
                    name: card.name;
                    section: card.section;
                    frequent: card.frequent;
                    radius: root.corner-radius;
                    card-bg: root.c-card;
                    border-col: root.c-border;
                    text-col: root.c-text;
                    sub-col: root.c-sub;
                    accent-col: root.c-accent;
                    flip-scale: root.flipping-index == card.idx ? root.flip-scale : 1.0;
                    launch(idx) => { root.launch-app(idx); }
                    shift(from, to) => { root.shift-card(from, to); }
                }

                // ── 系统板块卡：设置 / 关机 / 重启 ──
                Rectangle {
                    x: 24px;
                    y: 56px + (root.cards.length + 3) / 4 * 156px;
                    width: 688px;
                    height: 120px;
                    border-radius: root.corner-radius;
                    background: root.c-card;
                    border-width: 1px;
                    border-color: root.c-border;

                    VerticalLayout {
                        padding: 14px;
                        spacing: 10px;
                        Text { text: "系统"; color: root.c-text; font-size: 15px; }
                        HorizontalLayout {
                            spacing: 10px;
                            BarButton { label: "设置"; text-col: root.c-text; panel-bg: root.c-panel; clicked => { root.open-settings(); } }
                            BarButton { label: "重启"; text-col: root.c-text; panel-bg: root.c-panel; clicked => { root.reboot(); } }
                            BarButton { label: "关机"; text-col: root.c-text; panel-bg: root.c-panel; clicked => { root.power-off(); } }
                        }
                    }
                }

                if root.status-text != "": Text {
                    x: 24px;
                    y: 186px + (root.cards.length + 3) / 4 * 156px;
                    text: root.status-text;
                    color: root.c-sub;
                    font-size: 12px;
                }
            }
        }
    }
}
